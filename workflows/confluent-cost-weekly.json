    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Flatten all costs from all items\nconst allCosts = items.flatMap(item => JSON.parse(item.json.costBreakdown) || []);\n\nconst getEnvironment = (displayName) => {\n  if (!displayName) return 'other';\n  \n  const lower = displayName.toLowerCase();\n  \n  if (lower.includes('pro')) return 'prod';\n  if (lower.includes('pre')) return 'pre';\n  if (lower.includes('int')) return 'int';\n  return 'other';\n};\n\nconst costsByEnvironment = allCosts.reduce((acc, cost) => {\n  const env = getEnvironment(cost.resource?.display_name);\n  \n  if (!acc[env]) {\n    acc[env] = {\n      environment: env,\n      totalAmount: 0,\n      totalOriginalAmount: 0,\n      totalDiscount: 0,\n      count: 0,\n      items: []\n    };\n  }\n  \n  acc[env].totalAmount += cost.amount || 0;\n  acc[env].totalOriginalAmount += cost.original_amount || 0;\n  acc[env].totalDiscount += cost.discount_amount || 0;\n  acc[env].count += 1;\n  acc[env].items.push(cost);\n  \n  return acc;\n}, {});\n\n\n\n\nreturn Object.values(costsByEnvironment).map(env => ({ json: env }));"
      },
