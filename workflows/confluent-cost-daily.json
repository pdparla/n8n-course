    {
      "parameters": {
        "url": "https://api.confluent.cloud/billing/v1/costs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "start_date",
              "value": "={{ $now.minus(1, 'days').toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "end_date",
              "value": "={{ $now.toFormat('yyyy-MM-dd') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "5ec683ae-04f0-4946-91b0-c744e9406191",
      "name": "Get Confluent Costs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -1536,
        112
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "bo9emEYaUfjdxgET",
          "name": "Unnamed credential"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const apiResponse = $input.first().json;\nconst costDate = apiResponse.data[0].start_date;\nconst timestamp = Math.floor(new Date(costDate).getTime() / 1000);\n\n// precise sum without libraries\nconst items = apiResponse.data || [];\n\nconst getDecimalPlaces = (n) => {\n  if (!Number.isFinite(n)) return 0;\n  // produce a non-exponential string and trim trailing zeros\n  const s = Math.abs(n).toFixed(20).replace(/0+$/, '');\n  const idx = s.indexOf('.');\n  return idx === -1 ? 0 : s.length - idx - 1;\n};\n\nconst maxDecimals = items.length ? Math.max(...items.map(({ amount }) => getDecimalPlaces(Number(amount)))) : 0;\nconst scale = Math.pow(10, Math.min(maxDecimals, 18)); // limit to avoid huge exponents\n\nconst sumScaled = items.reduce((acc, { amount }) => {\n  const v = Number(amount);\n  if (!Number.isFinite(v)) return acc;\n  return acc + Math.round(v * scale);\n}, 0);\n\nconst totalCost = sumScaled / scale;\n\nreturn {\n  PK: 'COST',\n  SK: `DATE#${costDate}`,\n  date: costDate,\n  totalCost: Number(totalCost.toFixed(4)),\n  costBreakdown: JSON.stringify(apiResponse.data),\n  timestamp: timestamp,\n  createdAt: new Date().toISOString()\n};"
      },
      "id": "49e2ef0d-ae21-4de1-a779-abfda128d8c4",
      "name": "Transform API Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1328,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const currentData = $input.first().json;\nconst currentDate = currentData.date;\nconst previousDate = new Date(currentDate);\npreviousDate.setDate(previousDate.getDate() - 1);\nconst prevDateStr = previousDate.toISOString().split('T')[0];\n\nreturn {\n  currentCost: currentData.totalCost,\n  currentDate: currentDate,\n  previousDateKey: `DATE#${prevDateStr}`,\n  PK: 'COST'\n};"
      },
      "id": "244376d5-8f9f-40ec-a31e-060a8db3bbed",
      "name": "Calculate Previous Day",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const currentData = $(\"Calculate Previous Day\").first().json;\nconst previousData = $input.first().json;\n\n// Check if previous day data exists\nif (!previousData) {\n  return {\n    currentCost: currentData.currentCost,\n    previousCost: null,\n    percentageIncrease: 0,\n    shouldAlert: false,\n    date: currentData.currentDate,\n    message: 'No previous day data found - first day of tracking'\n  };\n}\n\nconst currentCost = currentData.currentCost;\nconst previousCost = parseFloat(previousData.totalCost.N);\n\nlet percentageIncrease = Number((((currentCost - previousCost) / previousCost) * 100).toFixed(2));\n\nreturn {\n  currentCost: currentCost,\n  previousCost: previousCost,\n  percentageIncrease: percentageIncrease,\n  shouldAlert: percentageIncrease > 10,\n  date: currentData.currentDate\n};"
      },
      "id": "d90f7831-e35f-4944-b7f3-e95bb55176bf",
      "name": "Calculate Cost Increase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
